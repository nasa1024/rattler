# 飞书自定义机器人配置
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_SECRET=
FEISHU_AT_ALL_ON_ALERT=true

# 定时与冷却配置（常驻模式生效）
CHECK_INTERVAL_MINUTES=60
ALERT_COOLDOWN_MINUTES=360
DAILY_REPORT_TIME=09:30

# 单账号快捷配置（若使用多账号请使用 config.json）
DEEPSEEK_API_KEY=
DEEPSEEK_MIN_BALANCE=20

OPENROUTER_API_KEY=
OPENROUTER_MIN_BALANCE_USD=5

# 小米 MiMo 控制台 Cookie（登录 https://platform.xiaomimimo.com/console/plan-manage 后 F12 复制请求头 Cookie）
XIAOMI_MIMO_COOKIE=
XIAOMI_MIMO_MAX_USED_PERCENT=85
XIAOMI_MIMO_MIN_BALANCE_CNY=0
